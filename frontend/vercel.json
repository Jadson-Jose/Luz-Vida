{
  "rewrites": [
    {
      "source": "/capitulo/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Twitterbot|WhatsApp|Discordbot|TelegramBot|LinkedInBot).*"
        }
      ],
      "destination": "/api/og?id=:id"
    }
  ]
}